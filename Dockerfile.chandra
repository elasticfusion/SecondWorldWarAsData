FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# --- Pinned versions (reproducibility; see docs/current/dataquality/CHANDRA_OCR_DESIGN.md) ---
# Resolved on the 2026-09-20 build. Bump deliberately, not implicitly.
#   chandra-ocr 0.2.0 / transformers 5.17.0 / tokenizers 0.23.2 / accelerate 1.15.0
#   huggingface_hub 1.32.0 / torch 2.5.1+cu121 / torchvision 0.20.1+cu121
#   model datalab-to/chandra-ocr-2 @ af93b47dba1b47b6640c86ccf487ed2260ab9a09
ENV CHANDRA_MODEL_REVISION=af93b47dba1b47b6640c86ccf487ed2260ab9a09

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev curl unzip && \
    curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscliv2.zip && \
    pip3 install --no-cache-dir \
        "chandra-ocr[hf]==0.2.0" \
        "transformers==5.17.0" \
        "tokenizers==0.23.2" \
        "accelerate==1.15.0" \
        "huggingface_hub==1.32.0" \
        "boto3==1.43.98" \
        "PyPDF2==3.0.1" && \
    pip3 install --no-cache-dir --force-reinstall --no-deps \
        "torch==2.5.1+cu121" "torchvision==0.20.1+cu121" \
        --index-url https://download.pytorch.org/whl/cu121 && \
    pip3 install --no-cache-dir \
        "nvidia-cudnn-cu12==9.1.0.70" "nvidia-cublas-cu12==12.1.3.1" \
        "nvidia-cuda-runtime-cu12==12.1.105" "nvidia-cuda-nvrtc-cu12==12.1.105" \
        "nvidia-cuda-cupti-cu12==12.1.105" "nvidia-cufft-cu12==11.0.2.54" \
        "nvidia-curand-cu12==10.3.2.106" "nvidia-cusolver-cu12==11.4.5.107" \
        "nvidia-cusparse-cu12==12.1.0.106" "nvidia-nccl-cu12==2.21.5" \
        "nvidia-nvtx-cu12==12.1.105" "triton==3.1.0" && \
    python3 -c "import torch, torchvision; assert torch.__version__ == '2.5.1+cu121', torch.__version__; print('torch', torch.__version__, 'torchvision', torchvision.__version__, 'OK')" && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
# torch install (above): chandra-ocr[hf] wants torch>=2.8.0, but we pin
# torch==2.5.1+cu121 for CUDA-12.1 compatibility with the deployed GPU driver.
# torch is installed with --no-deps so pip does NOT re-resolve torch 2.5.1's
# declared CUDA-dep wheels from the pytorch index: those nvidia-* wheels were
# re-hosted with drifted hashes and now fail --no-cache builds deterministically
# ("THESE PACKAGES DO NOT MATCH THE HASHES", a different nvidia-* pkg each run).
# We then install the exact CUDA runtime deps torch 2.5.1+cu121 needs (incl.
# libcudnn.so.9 via nvidia-cudnn-cu12==9.1.0.70) from PyPI, which serves them
# without that stale hash-file enforcement. The build-time import asserts the
# result is loadable. Verified in isolation 2026-09-23. See docs/current/TODO.md.

# Pre-download model weights into image (~8GB) to avoid runtime download.
# Download WITHOUT an explicit revision so HF writes the `refs/main` pointer the
# chandra CLI relies on (it loads `from_pretrained("datalab-to/chandra-ocr-2")`
# with no revision). Then ASSERT the resolved commit matches the pinned one, so
# the build FAILS if upstream `main` has moved — reproducibility is enforced,
# not merely hoped for. Bump CHANDRA_MODEL_REVISION deliberately when updating.
RUN python3 -c "\
import os; from huggingface_hub import snapshot_download; \
p = snapshot_download('datalab-to/chandra-ocr-2'); \
commit = os.path.basename(os.path.realpath(p)); \
exp = os.environ['CHANDRA_MODEL_REVISION']; \
assert commit == exp, f'chandra-ocr-2 main is {commit}, expected {exp}; bump CHANDRA_MODEL_REVISION intentionally'; \
from transformers import AutoProcessor, AutoModelForImageTextToText; \
AutoProcessor.from_pretrained('datalab-to/chandra-ocr-2'); \
AutoModelForImageTextToText.from_pretrained('datalab-to/chandra-ocr-2'); \
print('chandra-ocr-2 pinned at', commit)"

# After weights are baked in: force offline at RUNTIME so the container always
# uses the pinned, cached weights and never silently re-fetches a newer HF
# revision. (Set only now — the download RUN above needs network.)
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

COPY scripts/chandra_entrypoint.sh /entrypoint.sh
COPY scripts/ocr_watchdog.py /ocr_watchdog.py
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
