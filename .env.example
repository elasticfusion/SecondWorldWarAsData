# Grok API Configuration
GROK_API_KEY=your_api_key_here
GROK_API_BASE_URL=https://api.x.ai/v1/chat/completions
# The model is set in config.yaml (api.grok.model). GROK_MODEL overrides it for one run only;
# leave it unset here (a stale value made local runs ask a retired model, 2026-11-17).
# GROK_MODEL=


# NARA (National Archives) catalog API key — used by bibliography enrichment
NARA_API_KEY=your-nara-api-key-here
