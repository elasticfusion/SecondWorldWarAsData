---
# PROFILE: cost-optimized
# Minimizes API spend. Uses batch API (50% off), cheaper models for light tasks,
# aggressive caching, and limits external searches.
# Use when: processing new books in production, budgets are tight.

paths:
  content_root: "contentrepository"
  output_root: "output"
  content_output: "output/content"
  cache_root: "cache"
  review_root: "review"
  api_cache: "cache/api"
  image_cache: "cache/images"
  maps_images: "output/maps_images"
  people_data: "output/people.json"
  peoplegroup_data: "output/peoplegroups.json"
  supplemental_data: "output/supplemental.json"

api:
  grok:
    base_url: "https://api.x.ai/v1/chat/completions"
    model: "grok-4.3"  # xAI retired grok-4.20-0309-reasoning (May 15 2026) -> redirects here; grok-4.3 is Batch-API accepted. Alias = latest stable. Verify Batch support before bumping to grok-4.6/4.7.
    # Per-request-type models (cache_type -> model). Every model named here (and api.grok.model)
    # must be served AS ITSELF: each phase's preflight stops the run otherwise
    # (src/utils/grok_models). grok-3-mini was removed 2026-11-12: xAI no longer serves it
    # (answered by grok-4.3, so the "cheap" lookups were already running on grok-4.3).
    model_map: {}
    max_retries: 3
    timeout: 60
    # Live xAI prepaid credit (task 1.1c, src/utils/grok_balance; needs the management key secret
    # <env>-wwii-pipeline/xai-management-key). Under the floor a Phase 2/3 run does not start (the
    # book is deferred "funding" and resumes after a top-up); at or under the alert line a running
    # task alerts every hour and goes on. Checked every balance_check_minutes during a run.
    # Phase 0 imports are gated too when their title-page Grok request is on. A deployment that
    # does not use prepaid xAI credit (or has no management key) sets balance_check: false.
    # xAI auto top-up (console) can keep the balance above both lines: that is the operator's call.
    balance_check: true
    credit_floor_usd: 50
    credit_alert_usd: 10
    balance_check_minutes: 15
  calls_per_minute: 20                 # Conservative rate limit
  nara_api_key: ""
  noaa_api_token: ""

processing:
  validate_ulids: true
  generate_jq_queries: false           # Skip — not needed for production
  generate_download_scripts: false
  # Date-plausibility window for the semantic quality flag `date_out_of_window` (advisory, never
  # blocks). Generous by default so WWII antecedents (Abyssinia 1935, Spanish Civil War 1936-39,
  # Sino-Japanese 1937, Anschluss/Sudetenland 1938, Khalkhin Gol 1939) + late-1940s aftermath are
  # in-window. Override per corpus; env DATE_WINDOW_START / DATE_WINDOW_END take precedence.
  date_window:
    start: "1930-01-01"
    end: "1950-12-31"
  force_reprocess: false
  reprocess_types: []

weather:
  enabled: true
  fetch_api_data: true                 # Open-Meteo is free
  api_provider: "open-meteo"
  cache_responses: true
  only_precise_dates: true             # Skip vague dates (fewer API calls)
  timeout: 30

equipment:
  enabled: true
  enable_enrichment: false             # Skip enrichment — saves many API calls
  verify_media_with_vision: false      # Skip vision API ($$$)

logistics:
  enabled: true

casualties:
  enabled: true

# Trusted sources and link following (task 1.9, owner 2026-11-17; src/utils/link_policy, logged at
# the start of each Phase 3 run). A cited document from a trusted source is queued for ingestion
# with no URL Grok check and no human URL review; its CONTENT is still Grok-classified, and its
# links to untrusted sites follow the review rule. A trusted record found by a search still needs
# the Grok check that it is the cited document. match: host/path/ prefix (the exact host, www.
# ignored - other subdomains are other sites; the path is case-sensitive and ends in /). Adding
# a source is a config edit.
trusted_sources:
  - {name: hyperwar, match: ["ibiblio.org/hyperwar/"], forms: [html, pdf]}
  - {name: nara, match: ["catalog.archives.gov/id/", "catalog.archives.gov/medialive/", "catalog.archives.gov/medialz/"]}

links:
  # how far a followed link's own links are followed (hops) and how many per page, for links on
  # the parent page's own site and elsewhere (ceilings: 3 hops, 200 per page)
  follow:
    same_domain: {max_hops: 1, max_per_page: 20}
    external: {max_hops: 1, max_per_page: 20}

supplemental_material:
  enabled: true
  extract_citations: true              # Phase 2: parse citations into structured bibliography entries
  # Phase 2 performs NO supplemental searches (only Grokipedia/Wikipedia + submitting data to Grok).
  # Every search for where a cited document can be obtained runs in Phase 3 (bibliography_resolver):
  llm_search: true                     # Phase 3: Grok "LLM search" fallback (content-verified)
  search_gutenberg: true               # Phase 3: Gutendex API (free; independent of OpenSERP)
  search_archive_org: true             # Phase 3: archive.org API (free; independent of OpenSERP)
  search_amazon: true                  # Phase 3: a bookseller listing (Amazon, via OpenSERP site: search) for books; a pointer, never an online copy
  use_openserp: true                   # Phase 3 ONLY: OpenSERP service is scaled up on demand
  verify_archive_urls: false           # Skip verification pass
  extract_isbn: false                  # Skip — uses API calls
  determine_copyright: false           # Skip — uses API calls
  max_materials_per_chapter: 500       # Limit scope
  search_cache_days: 90                # a source (archive.org, Gutendex) is asked the same question at most once per this many days; an EMPTY answer is kept too
  openserp_cache_days: 14              # the same for OpenSERP (a scraped engine: an empty answer may only mean it was throttled)

concurrency:
  enabled: false
  max_event_files: 3
  max_extraction_group: 3
  max_enrichment_workers: 4                # bounded pool size for Phase-2 bio enrichment fetch (small, capped at 16)
  bio_enrichment_parallel: true            # parallelize the per-person Phase-2 bio FETCH (persist stays serial); set false to force serial

enrichment:
  re_search_after_days: 180            # Re-search less frequently

extraction:
  window_paragraphs: 3                 # people/groups/places/equipment discovery: paragraphs per request (env WINDOW_PARAGRAPHS)

# Per-book phase queues (src/utils/pending_queue.py). Each Phase 3 start counts an attempt on the
# book's pending#enrich# row; the row is removed on success, so a failed or stopped run is retried by
# the hourly reconcile. A book is never dropped (owner 2026-11-18): past phase3_max_attempts it is
# deferred "failure" and held until `python3 scripts/resume_book.py <book>`. A stop for Grok funds or
# connectivity uses no attempt and holds EVERY book; the reconcile retries after defer_retry_minutes.
queue:
  phase3_max_attempts: 3
  defer_retry_minutes: 50              # under the hourly reconcile, so its next run retries
  max_connectivity_deferrals: 24       # connectivity stops (since the last resume) before the book is held
  max_funding_deferrals: 72            # funding stops (since the last resume) before the book is held

# Fargate Spot price ladder (src/utils/spot_ladder.py, owner 2026-11-18). Every task starts on Spot at
# its task-definition size. Each reclaim of a book's task doubles vCPU and memory for its next launch,
# still on Spot, while that Spot price is at or under the ORIGINAL size's on-demand price x the
# fraction below; then it launches on-demand at the original size. Rates: lambda_handlers/
# price_refresh.py (daily; Spot from Cost Explorer, on-demand from the Price List API).
spot_ladder:
  max_fraction_of_on_demand: 1.0       # may be lowered, never raised above 1.0
  max_price_age_days: 3                # older rates: never upsize

batch:
  phase2: true                         # 50% off extraction
  phase3: false                        # Live calls — avoids network bounce between submit/retrieve
  max_rounds: 8                        # Phase 2 batch rounds before alert + stop (equipment ~6)
  in_task_wait_minutes: 5              # per round; not answered by then -> poller Lambda (5-min checks); env BATCH_IN_TASK_WAIT_MINUTES

# Provenance validation (scripts/validate_provenance.py): is every record's cited source content
# true (quotes in the cited paragraphs, locators in the cited sub-event)? Runs per book at the end
# of Phase 2. gate: warn = report + alert, the book goes on to Phase 3; block = Phase 3 is held for
# review when a hard check fails. PROVENANCE_GATE env overrides (no rebuild). Default: warn.
provenance_validation:
  gate: warn

# Deduplication scoring. All values optional — if a key (or the whole block) is
# absent, the built-in defaults below are used (= current behavior). Auto-merge stays
# conservative: with these defaults, nothing new auto-merges beyond byte-identical
# normalized names until you deliberately lower people.auto_merge_threshold.
dedup:
  people:
    candidate_threshold: 0.5           # min score to surface as a human-review candidate
    auto_merge_threshold: 999          # score to auto-merge w/o review; 999 = effectively off
                                       #   (byte-identical names still auto-merge separately).
    weights:                           # additive evidence weights
      shared_external_url: 3.0
      event_overlap_high: 1.5
      event_overlap_medium: 0.8
      shared_biographical: 0.5
      middle_initial_subset: 0.5       # "George Patton" vs "George S. Patton" (one omits middle)
      same_last_name: 0.4
    proximity:                         # PRIMARY signal: decays with mention radius (words apart)
      tight_radius_words: 60           # ~same paragraph
      near_radius_words: 400           # ~same page/section
      loose_radius_words: 4000         # same book, far apart
      tight_weight: 0.8
      near_weight: 0.4
      loose_weight: 0.15
      cross_document_weight: 0.0
    # Disambiguation veto: both names carry a comparable middle initial/name AND they
    # DIFFER (George S. vs George P. Patton) -> strong negative that overrides proximity.
    conflicting_middle_initial_weight: -5.0
    # Disambiguation veto: two FULL names with different surnames are different people, however
    # alike the first names ("William E. Dreher, Jr." vs "William R. Benn, Jr."). A surname
    # within surname_variant_ratio (an OCR/spelling variant: Schwarzwalder/Schwarzwaldor) is the
    # same surname. Lifted only by a shared external URL or a title alias.
    different_surname_weight: -5.0
    surname_variant_ratio: 0.8
    frequency:                         # SECONDARY: a surname dominating a book (Patton book)
      enabled: true
      dominant_surname_boost: 0.3      # applied only with a compatible first name/initial
    commonness:                        # common surnames (many distinct first names) dampen proximity
      enabled: true
      common_surname_damping: 0.5
    # Nationality-aware surname rarity (preferred over corpus commonness when the
    # person's nationality + a table entry are known). Our own curated, growable table.
    surname_frequency:
      enabled: true
      path: data/surname_frequency.yaml
      rare_multiplier: 1.5             # rare surname in that nationality -> stronger match
      uncommon_multiplier: 1.1
      common_multiplier: 0.6
      very_common_multiplier: 0.4      # e.g. Kowalski among Poles, Smith among Americans
    # Rank is point-in-time. Different rank-set + TIGHT proximity = mild negative (likely
    # two people together); across wide separation = neutral (promotion plausible). Dampen.
    rank_proximity:
      enabled: true
      tight_penalty: -0.6
      near_penalty: -0.2
      loose_penalty: 0.0
    # Human-gated corpus-frequency SUGGESTION report (output/people/
    # surname_frequency_suggestions.json). Regenerated only when the corpus GROWS by
    # >= min_new_people. Suggestion-only — never auto-edits data/surname_frequency.yaml.
    # Skew-safe (keyed on distinct people per surname, not raw mentions).
    surname_report:
      enabled: true
      min_new_people: 50               # regenerate only after this many new people
    # Shared people-group (unit) affiliation = WEAK positive, strength INVERSE to unit
    # size (echelon). Smaller unit shared -> stronger (few share a company); regiment/
    # division -> super-weak/noise. Matched on resolved GroupID first, then normalized
    # designation. Tiny weights: a NUDGE for name-evidenced candidates, never decisive.
    shared_unit:
      enabled: true
      echelon_weights:
        squad: 0.6                     # smallest unit -> strongest shared-affiliation signal
        section: 0.6
        platoon: 0.5
        company: 0.4
        battery: 0.4
        squadron: 0.4
        battalion: 0.25
        regiment: 0.1                  # "Smith in the 110th Infantry Regiment" — weak
        group: 0.1
        brigade: 0.08
        division: 0.03                 # ~noise
        wing: 0.03
        corps: 0.0
        army: 0.0
        fleet: 0.0
        command: 0.0
      unknown_echelon_weight: 0.1      # shared unit, echelon not classified

  # Groups (people-groups / units) dedup. Canonical unit key is the PRIMARY matcher:
  # number + branch (INFANTRY DEFAULT when unspecified) + echelon. Branch mismatch and
  # echelon mismatch (both present) VETO a merge (so "9th Armored" != "9th Division").
  # Proximity corroborates (promotes "110th" near "110th Regiment"); never overrides a veto.
  groups:
    canonical_key:
      enabled: true
      infantry_default: true           # unspecified branch -> infantry
    proximity:
      enabled: true
      tight_radius_words: 60
      near_radius_words: 400
      loose_radius_words: 4000
      tight_weight: 0.6
      near_weight: 0.3
      loose_weight: 0.1
      cross_document_weight: 0.0

openserp:
  results_per_query: 5                 # results per OpenSERP query (each one may cost a Grok verify)
  max_photo_checks_per_entity: 10      # photo downloads + Grok vision checks per entity per run (1-100)
  max_result_pages: 3                  # a productive entity's re-search goes one result page deeper, up to this many pages
  max_images_per_entity: 3
  max_web_results_per_entity: 3
  rate_limit_seconds: 5                # Polite spacing between OpenSERP queries (serial)
  request_timeout_seconds: 60          # Per-query HTTP timeout; raised for headless-browser latency
                                       #   (Chromium across multiple engines can exceed 30s under load)

maps:
  enabled: true
  extract_during_phase1: true
  # Download map image bytes into the corpus (durability/provenance: the source host can
  # change/vanish; a citable historical corpus should hold the actual bytes). Storage MUST be
  # under output/ — BackgroundSync only syncs output/ + artifacts/ to S3; filestore/ is ephemeral.
  download_images: true
  storage_backend: "filesystem"
  storage_path: "output/maps/"
  image_storage_path: "output/maps/files/"

# Phase 0: translate non-English documents to English (default true; English costs nothing)
ingestion:
  translate: true

images:
  enabled: true
  download: true                       # fetch image bytes into output/ (synced to S3)
  image_storage_path: "output/images/files/"

external_maps:
  enabled: false                       # Disable external map search (expensive: OpenSERP + vision)
  # In-document maps (author-curated, linked from the narrative, e.g. HyperWar maps/*.jpg): read
  # what each map depicts (Grok vision: units, places, sector, date, movements) and recycle it as a
  # map-as-source document. INDEPENDENT of `enabled` above (the OpenSERP web search). One vision
  # call + one extra source document per map. Map ENTITIES are persisted regardless of this flag.
  recycle_in_doc_maps: true
  max_recycled_per_doc: 50             # cost cap per document (alerts when hit)
  # allowed_hosts: []                  # extra hosts whose map links may be fetched (ibiblio.org is built in);
  #                                    # the uploaded document's own host is NOT trusted

storage:
  entity_backend: "filesystem"

aws:
  enabled: false
  region: "us-east-1"
  # Operator alert email. deploy_aws.py passes this as the CFN NotificationEmail param,
  # which subscribes it to the {env}-wwii-phase2-complete SNS topic so dedup-gate review
  # alerts + pipeline/cost notifications reach EMAIL as well as Slack (alerts go to BOTH;
  # email is the redundancy leg). Leave empty to skip the email subscription.
  notification_email: ""

logging:
  level: "INFO"
  file: "logs/pipeline.log"
  console: true
  debug_message_preview_chars: 500
  debug_response_preview_chars: 500
