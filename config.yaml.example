---
# PROFILE: cost-optimized
# Minimizes API spend. Uses batch API (50% off), cheaper models for light tasks,
# aggressive caching, and limits external searches.
# Use when: processing new books in production, budgets are tight.

paths:
  content_root: "contentrepository"
  output_root: "output"
  content_output: "output/content"
  cache_root: "cache"
  review_root: "review"
  api_cache: "cache/api"
  image_cache: "cache/images"
  maps_images: "output/maps_images"
  people_data: "output/people.json"
  peoplegroup_data: "output/peoplegroups.json"
  supplemental_data: "output/supplemental.json"

api:
  grok:
    base_url: "https://api.x.ai/v1/chat/completions"
    model: "grok-4.20-0309-reasoning"  # batch-supported (grok-4.6 is NOT accepted by the Batch API)
    model_map:
      isbn: "grok-3-mini"             # Cheap model for simple lookups
      url_verify: "grok-3-mini"
      copyright: "grok-3-mini"
      nara_match: "grok-3-mini"
      openserp_verify: "grok-3-mini"
    max_retries: 3
    timeout: 60
  calls_per_minute: 20                 # Conservative rate limit
  nara_api_key: ""
  noaa_api_token: ""

processing:
  validate_ulids: true
  generate_jq_queries: false           # Skip — not needed for production
  generate_download_scripts: false
  force_reprocess: false
  reprocess_types: []

weather:
  enabled: true
  fetch_api_data: true                 # Open-Meteo is free
  api_provider: "open-meteo"
  cache_responses: true
  only_precise_dates: true             # Skip vague dates (fewer API calls)
  timeout: 30

equipment:
  enabled: true
  enable_enrichment: false             # Skip enrichment — saves many API calls
  verify_media_with_vision: false      # Skip vision API ($$$)

logistics:
  enabled: true

casualties:
  enabled: true

supplemental_material:
  enabled: true
  extract_citations: true
  enrich_with_searches: true
  llm_search: true
  search_gutenberg: true               # Free
  search_archive_org: true             # Free
  use_openserp: false                  # Disable — requires running OpenSERP service ($)
  verify_archive_urls: false           # Skip verification pass
  extract_isbn: false                  # Skip — uses API calls
  determine_copyright: false           # Skip — uses API calls
  max_materials_per_chapter: 500       # Limit scope

concurrency:
  enabled: false
  max_event_files: 3
  max_extraction_group: 3
  max_enrichment_workers: 4

enrichment:
  re_search_after_days: 180            # Re-search less frequently

batch:
  phase2: true                         # 50% off extraction
  phase3: false                        # Live calls — avoids network bounce between submit/retrieve

# Deduplication scoring. All values optional — if a key (or the whole block) is
# absent, the built-in defaults below are used (= current behavior). Auto-merge stays
# conservative: with these defaults, nothing new auto-merges beyond byte-identical
# normalized names until you deliberately lower people.auto_merge_threshold.
dedup:
  people:
    candidate_threshold: 0.5           # min score to surface as a human-review candidate
    auto_merge_threshold: 999          # score to auto-merge w/o review; 999 = effectively off
                                       #   (byte-identical names still auto-merge separately).
    weights:                           # additive evidence weights
      shared_external_url: 3.0
      event_overlap_high: 1.5
      event_overlap_medium: 0.8
      shared_biographical: 0.5
      middle_initial_subset: 0.5       # "George Patton" vs "George S. Patton" (one omits middle)
      same_last_name: 0.4
    proximity:                         # PRIMARY signal: decays with mention radius (words apart)
      tight_radius_words: 60           # ~same paragraph
      near_radius_words: 400           # ~same page/section
      loose_radius_words: 4000         # same book, far apart
      tight_weight: 0.8
      near_weight: 0.4
      loose_weight: 0.15
      cross_document_weight: 0.0
    # Disambiguation veto: both names carry a comparable middle initial/name AND they
    # DIFFER (George S. vs George P. Patton) -> strong negative that overrides proximity.
    conflicting_middle_initial_weight: -5.0
    frequency:                         # SECONDARY: a surname dominating a book (Patton book)
      enabled: true
      dominant_surname_boost: 0.3      # applied only with a compatible first name/initial
    commonness:                        # common surnames (many distinct first names) dampen proximity
      enabled: true
      common_surname_damping: 0.5
    # Nationality-aware surname rarity (preferred over corpus commonness when the
    # person's nationality + a table entry are known). Our own curated, growable table.
    surname_frequency:
      enabled: true
      path: data/surname_frequency.yaml
      rare_multiplier: 1.5             # rare surname in that nationality -> stronger match
      uncommon_multiplier: 1.1
      common_multiplier: 0.6
      very_common_multiplier: 0.4      # e.g. Kowalski among Poles, Smith among Americans
    # Rank is point-in-time. Different rank-set + TIGHT proximity = mild negative (likely
    # two people together); across wide separation = neutral (promotion plausible). Dampen.
    rank_proximity:
      enabled: true
      tight_penalty: -0.6
      near_penalty: -0.2
      loose_penalty: 0.0
    # Human-gated corpus-frequency SUGGESTION report (output/people/
    # surname_frequency_suggestions.json). Regenerated only when the corpus GROWS by
    # >= min_new_people. Suggestion-only — never auto-edits data/surname_frequency.yaml.
    # Skew-safe (keyed on distinct people per surname, not raw mentions).
    surname_report:
      enabled: true
      min_new_people: 50               # regenerate only after this many new people
    # Shared people-group (unit) affiliation = WEAK positive, strength INVERSE to unit
    # size (echelon). Smaller unit shared -> stronger (few share a company); regiment/
    # division -> super-weak/noise. Matched on resolved GroupID first, then normalized
    # designation. Tiny weights: a NUDGE for name-evidenced candidates, never decisive.
    shared_unit:
      enabled: true
      echelon_weights:
        squad: 0.6                     # smallest unit -> strongest shared-affiliation signal
        section: 0.6
        platoon: 0.5
        company: 0.4
        battery: 0.4
        squadron: 0.4
        battalion: 0.25
        regiment: 0.1                  # "Smith in the 110th Infantry Regiment" — weak
        group: 0.1
        brigade: 0.08
        division: 0.03                 # ~noise
        wing: 0.03
        corps: 0.0
        army: 0.0
        fleet: 0.0
        command: 0.0
      unknown_echelon_weight: 0.1      # shared unit, echelon not classified

  # Groups (people-groups / units) dedup. Canonical unit key is the PRIMARY matcher:
  # number + branch (INFANTRY DEFAULT when unspecified) + echelon. Branch mismatch and
  # echelon mismatch (both present) VETO a merge (so "9th Armored" != "9th Division").
  # Proximity corroborates (promotes "110th" near "110th Regiment"); never overrides a veto.
  groups:
    canonical_key:
      enabled: true
      infantry_default: true           # unspecified branch -> infantry
    proximity:
      enabled: true
      tight_radius_words: 60
      near_radius_words: 400
      loose_radius_words: 4000
      tight_weight: 0.6
      near_weight: 0.3
      loose_weight: 0.1
      cross_document_weight: 0.0

openserp:
  results_per_query: 10                # Fewer results = fewer verification calls
  max_images_per_entity: 3
  max_web_results_per_entity: 3
  rate_limit_seconds: 5

maps:
  enabled: true
  extract_during_phase1: true
  download_images: false               # Don't download images (saves bandwidth/storage)
  storage_backend: "filesystem"
  storage_path: "output/maps/"
  image_storage_path: "filestore/maps/"

external_maps:
  enabled: false                       # Disable external map search (expensive: OpenSERP + vision)

storage:
  entity_backend: "filesystem"

aws:
  enabled: false
  region: "us-east-1"

logging:
  level: "INFO"
  file: "logs/pipeline.log"
  console: true
  debug_message_preview_chars: 500
  debug_response_preview_chars: 500
