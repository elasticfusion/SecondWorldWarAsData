FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# --- Pinned versions (reproducibility; mirrors Dockerfile.chandra discipline) ---
# Resolved/validated in the PP-StructureV3 PoC (2026-09-22): PP-StructureV3
# recovers the 2-D task-org tables Chandra flattens, and the SERVER text models
# out-transcribe the mobile ones on this content. Bump deliberately, not
# implicitly. See docs/current/dataquality/CHANDRA_OCR_DESIGN.md
# ("Augmenting Chandra with a second OCR engine").
#   paddleocr 3.7.0 / paddlepaddle 3.3.1 (GPU) / paddlex 3.7.2
# The GPU paddlepaddle wheel is installed from Paddle's CUDA-12.x index.

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev curl unzip \
        libgl1 libglib2.0-0 libgomp1 && \
    curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscliv2.zip && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# PaddlePaddle GPU build (CUDA 12.x) from the official Paddle wheel index, then
# PaddleOCR + the OCR extras that PP-StructureV3 requires (layout, table).
RUN pip3 install --no-cache-dir \
        "paddlepaddle-gpu==3.3.1" \
        -i https://www.paddlepaddle.org.cn/packages/stable/cu126/ && \
    pip3 install --no-cache-dir \
        "paddleocr==3.7.0" \
        "paddlex[ocr]==3.7.2" \
        "boto3==1.43.98" \
        "PyMuPDF==1.27.2.2"

# Security pins (Trivy HIGH/CRITICAL remediation, 2026-09-22). Applied AFTER the
# paddle stack so they override the transitive versions it pulled in:
#   anyio    4.12.1 -> 4.14.2  (CVE-2026-63374, CRITICAL)
#   pillow   12.1.0 -> 12.3.0  (multiple crafted-image DoS/heap CVEs; relevant
#                               since this container processes image files)
#   protobuf 6.33.4 -> 6.33.5  (CVE-2026-0994, recursion-depth DoS)
# Re-verify with a Trivy scan when bumping the paddle stack, in case pins drift.
RUN pip3 install --no-cache-dir \
        "anyio>=4.14.2" \
        "pillow>=12.3.0" \
        "protobuf>=6.33.5"

# Model weights are downloaded on first job run (PP-StructureV3 fetches the
# server det/rec + layout + table models to ~/.paddlex on first predict). We do
# NOT warm them at build time: the paddlepaddle-GPU wheel links libcuda.so.1
# (the NVIDIA driver), which is absent on the CPU build host, so importing
# paddle at build fails. The download is a one-time cost on the first Batch job;
# a warm-up job can prime a persistent cache later if needed. PADDLE_PDX_* below
# still pins the model SOURCE behavior at runtime.

# App code: the in-repo runner + auto-routing bridge + worker entrypoint.
WORKDIR /app
COPY src/ /app/src/
COPY scripts/paddle_recover_page.py /app/scripts/paddle_recover_page.py
COPY scripts/paddle_entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Skip the model-source connectivity check at runtime (the check itself is slow
# and flaky in a locked-down VPC). Models still download on first predict via the
# normal source; we do NOT force HF offline here because the first job needs to
# fetch weights. A future warm-cache step can bake them in via a builder stage.
ENV PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

ENTRYPOINT ["/entrypoint.sh"]
