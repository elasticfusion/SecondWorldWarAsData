FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# --- Pinned versions (reproducibility; mirrors Dockerfile.chandra discipline) ---
# Resolved/validated in the PP-StructureV3 PoC (2026-09-22): PP-StructureV3
# recovers the 2-D task-org tables Chandra flattens, and the SERVER text models
# out-transcribe the mobile ones on this content. Bump deliberately, not
# implicitly. See docs/current/dataquality/CHANDRA_OCR_DESIGN.md
# ("Augmenting Chandra with a second OCR engine").
#   paddleocr 3.7.0 / paddlepaddle 3.3.1 (GPU) / paddlex 3.7.2
# The GPU paddlepaddle wheel is installed from Paddle's CUDA-12.x index.

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev curl unzip \
        libgl1 libglib2.0-0 && \
    curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscliv2.zip && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# PaddlePaddle GPU build (CUDA 12.x) from the official Paddle wheel index, then
# PaddleOCR + the OCR extras that PP-StructureV3 requires (layout, table).
RUN pip3 install --no-cache-dir \
        "paddlepaddle-gpu==3.3.1" \
        -i https://www.paddlepaddle.org.cn/packages/stable/cu126/ && \
    pip3 install --no-cache-dir \
        "paddleocr==3.7.0" \
        "paddlex[ocr]==3.7.2" \
        "boto3==1.43.98" \
        "PyMuPDF==1.27.2.2"

# Pre-download the PP-StructureV3 model set the runner uses (server det/rec +
# layout + table-structure models) so no per-job download is needed. We warm the
# exact server-model pipeline configured in src/ingestion/paddle_structure.py.
# Runs on CPU at build time (no GPU in the build host); weights are device-
# agnostic. enable_mkldnn=False mirrors the runner (avoids the paddlepaddle
# 3.3.x MKL-DNN PIR bug on CPU).
RUN python3 -c "\
from paddleocr import PPStructureV3; \
PPStructureV3(device='cpu', enable_mkldnn=False, \
    text_detection_model_name='PP-OCRv5_server_det', \
    text_recognition_model_name='PP-OCRv5_server_rec', \
    text_det_limit_side_len=2048, text_det_limit_type='max', \
    use_formula_recognition=False); \
print('PP-StructureV3 server models cached')"

# App code: the in-repo runner + auto-routing bridge + worker entrypoint.
WORKDIR /app
COPY src/ /app/src/
COPY scripts/paddle_recover_page.py /app/scripts/paddle_recover_page.py
COPY scripts/paddle_entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Force offline model source at RUNTIME so a job always uses the baked, pinned
# weights and never silently fetches newer ones (mirrors Chandra's offline env).
ENV PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
ENV HF_HUB_OFFLINE=1

ENTRYPOINT ["/entrypoint.sh"]
