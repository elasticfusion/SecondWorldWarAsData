# Minimal overlay: add the missing libgomp1 (OpenMP runtime) to the existing
# Paddle image. PaddlePaddle's core (paddle/base/libpaddle.so) links against
# libgomp.so.1; without it, PP-StructureV3 crashes at import ("Can not import
# paddle core" -> CPU fallback -> "libgomp.so.1: cannot open shared object
# file"), so recovery jobs ran but reconstructed 0 tables (validated on the
# St. Vith task-org pages, 2026-09-23).
#
# Layered onto the existing image to avoid a full --no-cache rebuild. The next
# full rebuild picks up the same fix from Dockerfile.paddle directly.
FROM localhost/wwii-paddle:latest

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgomp1 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
