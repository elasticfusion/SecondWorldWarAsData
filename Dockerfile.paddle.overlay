# Overlay for the Paddle (PP-StructureV3) worker: layer code/lib fixes onto the
# last good image without a full --no-cache rebuild (see TODO on torch/CDN hash
# drift; the same rebuild fragility applies to the paddle stack).
#
# Two fixes stacked here, both from the St. Vith end-to-end validation:
#   1) libgomp1 — PaddlePaddle core (libpaddle.so) links libgomp.so.1; without
#      it PP-StructureV3 crashed at import (already in the :libgomp base below).
#   2) src/ update — enable document/textline orientation correction in
#      src/ingestion/paddle_structure.py so 90deg-rotated OOB task-org pages are
#      de-rotated before table detection (fixes p156 recovering 0 tables).
#
# The full rebuild picks up both from Dockerfile.paddle directly.
FROM localhost/wwii-paddle:libgomp

COPY src/ /app/src/
COPY scripts/paddle_recover_page.py /app/scripts/paddle_recover_page.py
