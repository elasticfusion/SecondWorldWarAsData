# NOTE: the real output/** dataset is ignored above (S3-backed, disposable), but the
# curated schema-validation fixtures under tests/fixtures/validation/** ARE tracked
# on purpose (they give CI real shapes to validate — see that dir's README). They do
# not live under output/, so no un-ignore is needed; keep it that way (do not add a
# broad tests/**/*.json or output-style rule that would capture them).

# Auto-generated learned equipment aliases (runtime state, not curated source)
config/equipment_aliases_learned.yaml

# Local sync target for AWS pipeline results (aws s3 sync .../output -> outputs/) — not committed
outputs/

# AWS CLI v2 installer bundle (unzipped awscli-exe-linux-*.zip). Not part of the project:
# install the CLI from AWS, don't vendor it. Ignored so it can't be re-committed by accident.
/aws/
