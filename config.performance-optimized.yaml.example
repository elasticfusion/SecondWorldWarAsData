---
# PROFILE: performance-optimized
# Maximizes speed regardless of cost. Live API calls, max concurrency, no batch waits.
# Use when: testing changes, iterating on prompts, tight deadlines.
# Expect: 3-5x higher API costs vs cost-optimized.

paths:
  content_root: "contentrepository"
  output_root: "output"
  content_output: "output/content"
  cache_root: "cache"
  review_root: "review"
  api_cache: "cache/api"
  image_cache: "cache/images"
  maps_images: "output/maps_images"
  people_data: "output/people.json"
  peoplegroup_data: "output/peoplegroups.json"
  supplemental_data: "output/supplemental.json"

api:
  grok:
    base_url: "https://api.x.ai/v1/chat/completions"
    model: "grok-4.3"
    model_map: {}                      # Best model everywhere — speed over savings
    max_retries: 2                     # Fail fast, move on
    timeout: 45                        # Short timeout — don't wait for hung requests
  calls_per_minute: 60                 # Push rate limit (adjust if 429s appear)
  nara_api_key: ""
  noaa_api_token: ""

processing:
  validate_ulids: true
  generate_jq_queries: false           # Skip non-essential I/O
  generate_download_scripts: false
  force_reprocess: false
  reprocess_types: []                  # To re-extract one type: ["supplemental"], ["people"], etc.

weather:
  enabled: true
  fetch_api_data: true
  api_provider: "open-meteo"
  cache_responses: true
  only_precise_dates: true
  timeout: 10                          # Fail fast on slow API

equipment:
  enabled: true
  enable_enrichment: true
  verify_media_with_vision: true

logistics:
  enabled: true

casualties:
  enabled: true

supplemental_material:
  enabled: true
  extract_citations: true
  enrich_with_searches: true
  llm_search: true
  search_gutenberg: true
  search_archive_org: true
  use_openserp: true
  verify_archive_urls: true
  extract_isbn: true
  determine_copyright: true
  max_materials_per_chapter: 1000

concurrency:
  enabled: true                        # Max parallelism
  max_event_files: 6                   # Process 6 chapters at once
  max_extraction_group: 6             # 6 parallel extractions per group
  max_enrichment_workers: 12           # 12 concurrent enrichment threads

enrichment:
  re_search_after_days: 90

batch:
  phase2: false                        # Live calls — no waiting for batch completion
  phase3: false                        # Live calls

openserp:
  results_per_query: 20
  max_images_per_entity: 5
  max_web_results_per_entity: 5
  rate_limit_seconds: 2                # Aggressive search rate

maps:
  enabled: true
  extract_during_phase1: true
  download_images: true
  storage_backend: "filesystem"
  storage_path: "output/maps/"
  image_storage_path: "filestore/maps/"

external_maps:
  enabled: true
  max_places: 50
  openserp_url: "http://localhost:7001"
  search_limit: 50
  verify_with_vision: true
  max_images_per_page: 5
  image_download_timeout: 15           # Short timeouts
  page_download_timeout: 10
  image_storage_path: "filestore/external_maps/"
  storage_path: "output/external_maps/"
  require_license: true
  allowed_licenses:
    - "Public Domain"
    - "CC0"
    - "CC-BY"
    - "CC-BY-SA"
    - "Unknown"
  download_images: false
  link_to_places: true
  link_to_dates: true

storage:
  entity_backend: "filesystem"

aws:
  enabled: false
  region: "us-east-1"

logging:
  level: "INFO"
  file: "logs/pipeline.log"
  console: true
  debug_message_preview_chars: 5000
  debug_response_preview_chars: 5000
